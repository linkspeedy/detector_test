TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

TELEGRAM_BOT_TOKEN_2=your_monitoring_bot_token_here
TELEGRAM_CHAT_ID_2=your_monitoring_chat_id_here

TARGET_WALLET_ADDRESS=your_wallet_address_to_monitor_here

# RPC Endpoints
# Public RPCs can have rate limits. If the bot stops working, 
# sign up for Alchemy (alchemy.com) or Infura (infura.io) and replace these.
ETH_RPC_URL=https://eth.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org

# How often to check for new deposits (in seconds)
POLL_INTERVAL=15
